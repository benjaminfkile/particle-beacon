{
  "name": "particle-beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --enable-source-maps --loader ts-node/esm src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:check": "node scripts/check-contracts.mjs",
    "check:no-infra": "node scripts/check-no-infra.mjs",
    "beacon:check": "node scripts/check-beacon-library.mjs"
  },
  "dependencies": {
    "beacon-library": "file:vendor/beacon-library-1.2.0.tgz",
    "pino": "9.5.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
